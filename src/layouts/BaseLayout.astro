---
import '../styles/global.css';
import { site } from '../config/site';

interface Props {
  title?: string;
  description?: string;
}

const {
  title = `${site.name} | ${site.role}`,
  description = site.tagline,
} = Astro.props;

const pathname = Astro.url.pathname;
const nav = [
  { href: '/', label: 'Home' },
  { href: '/projects', label: 'Projects' },
  { href: '/about', label: 'About' },
  { href: '/resume', label: 'Résumé' },
  { href: '/contact', label: 'Contact' },
];
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="description" content={description} />
    <meta name="generator" content={Astro.generator} />
    <link rel="icon" type="image/svg+xml" href="/images/logo1-sq.png" />
    <title>{title}</title>
  </head>
  <body>
    <header class="site-header">
      <a class="brand" href="/" aria-label={`${site.name} homepage`}>
        <span class="brand-mark"><img src="images/logo1-sq.png"></span>
        <span>{site.name}</span>
      </a>
      <nav aria-label="Primary navigation">
        {nav.map((item) => (
          <a class:list={{ active: pathname === item.href || (item.href !== '/' && pathname.startsWith(item.href)) }} href={item.href}>
            {item.label}
          </a>
        ))}
      </nav>
    </header>
    <main>
      <slot />
    </main>
    <footer class="site-footer">
      <p>© {new Date().getFullYear()} {site.name}. Built with Astro and deployed as a static site.</p>
      <div class="footer-links">
        <a href={site.github} target="_blank" rel="noopener noreferrer">GitHub</a>
        <a href={site.linkedin} target="_blank" rel="noopener noreferrer">LinkedIn</a>
        <a href={`mailto:${site.email}`} target="_blank" rel="noopener noreferrer">Email</a>
        <a href={site.blog} target="_blank" rel="noopener noreferrer">Medium</a>
      </div>
    </footer>
  </body>
</html>
