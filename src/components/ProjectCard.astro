---
interface Props {
  slug: string;
  title: string;
  summary: string;
  status: string;
  technologies: string[];
}
const { slug, title, summary, status, technologies } = Astro.props;
const base = import.meta.env.BASE_URL;
---
<article class="project-card">
  <div class="card-heading">
    <span class="eyebrow">{status}</span>
    <h3><a href={`${base}projects/${slug}/`}>{title}</a></h3>
  </div>
  <p>{summary}</p>
  <ul class="tag-list" aria-label="Technologies">
    {technologies.slice(0, 5).map((technology) => <li>{technology}</li>)}
  </ul>
  <a class="text-link" href={`${base}/projects/${slug}/`}>Read case study →</a>
</article>
